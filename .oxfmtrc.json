{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "reports/",
    "test-results/",
    "package-lock.json",
    "package.json",
    "README.md"
  ]
}
